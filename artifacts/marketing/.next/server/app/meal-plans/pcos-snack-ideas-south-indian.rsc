a:T41d,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is a South Indian PCOS diet effective?","acceptedAnswer":{"@type":"Answer","text":"Yes — South Indian cuisine offers many pcos-friendly ingredients naturally. Adapting traditional south indian recipes to your health needs is one of the most sustainable dietary approaches."}},{"@type":"Question","name":"What are the best South Indian foods for PCOS?","acceptedAnswer":{"@type":"Answer","text":"South Indian cuisine includes hormone-friendly and low-GI foods that directly support pcos management. Key staples include local grains, seasonal vegetables, and traditional spices with therapeutic properties."}},{"@type":"Question","name":"How does MealCoreAI personalise my PCOS meal plan?","acceptedAnswer":{"@type":"Answer","text":"MealCoreAI analyses your specific health profile, regional food preferences, cooking time, and taste preferences to generate a weekly PCOS meal plan with real dish names, portions, and grocery lists — updated every week."}}]}2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://mealcoreai.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"PCOS Meal Plan\",\"item\":\"https://mealcoreai.com/pcos-meal-plan\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"South Indian PCOS Snack Ideas\",\"item\":\"https://mealcoreai.com/meal-plans/pcos-snack-ideas-south-indian\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$a"}}],["$","main",null,{"className":"min-h-screen bg-white","children":[["$","section",null,{"className":"py-16 px-4","style":{"background":"linear-gradient(135deg, #fb718515 0%, #fff 60%)"},"children":["$","div",null,{"className":"max-w-4xl mx-auto","children":[["$","nav",null,{"className":"flex item
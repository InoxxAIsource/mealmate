y-50 flex items-center justify-between list-none","children":[["$","span",null,{"children":"Is the pregnancy plan safe for all trimesters?"}],["$","span",null,{"className":"text-gray-400 group-open:rotate-180 transition-transform text-lg shrink-0 ml-3","children":"▾"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-700 text-sm leading-relaxed border-t border-gray-100 pt-4","children":"Yes — MealCoreAI generates trimester-specific pregnancy plans. The first trimester emphasises folate-rich foods and nausea-friendly preparations. The second trimester focuses on iron and calcium. The third trimester emphasises DHA, protein, and preparing nutritionally for labour and breastfeeding."}]]}],["$","details","3",{"className":"border border-gray-200 rounded-2xl overflow-hidden group","children":[["$","summary",null,{"className":"px-5 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 flex items-center justify-between list-none","children":[["$","span",null,{"children":"Does the pregnancy plan avoid unsafe foods automatically?"}],["$","span",null,{"className":"text-gray-400 group-open:rotate-180 transition-transform text-lg shrink-0 ml-3","children":"▾"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-700 text-sm leading-relaxed border-t border-gray-100 pt-4","children":"Yes — the pregnancy plan automatically excludes high-mercury fish, unpasteurised dairy, raw sprouts, excess vitamin A sources, and other pregnancy-unsafe foods. It also flags potential food safety considerations for each trimester."}]]}],["$","details","4",{"className":"border border-gray-200 rounded-2xl overflow-hidden group","children":[["$","summary",null,{"className":"px-5 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 flex items-center justify-between list-none","children":[["$","span",null,{"children":"Can I use the pregnancy plan if I have gestational diabetes?"}],["$","span",null,{"className":"text-gray-400 group-open:rotate-180 transition-transform text-lg shrink-0 ml-3","children":"▾"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-700 text-sm leading-relaxed border-t border-gray-100 pt-4","children":"Yes — select both 'Pregnancy' and 'Gestational Diabetes' in your health profile. MealCoreAI will generate a plan that addresses both conditions simultaneously — blood sugar management within the nutritional requirements of pregnancy."}]]}]]}]]}],["$","div","Kids & Cholesterol",{"children":[["$","h2",null,{"className":"text-2xl font-bold text-gray-900 flex items-center gap-2 mb-6","children":[["$","span",null,{"children":"👶"}]," ","Kids & Cholesterol"]}],["$","div",null,{"className":"space-y-3","children":[["$","details","0",{"className":"border border-gray-200 rounded-2xl overflow-hidden group","children":[["$","summary",null,{"className":"px-5 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 flex items-center justify-between list-none","children":[["$","span",null,{"children":"What age range is the kids meal plan designed for?"}],["$","span",null,{"className":"text-gray-400 group-open:rotate-180 transition-transform text-lg shrink-0 ml-3","children":"▾"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-700 text-sm leading-relaxed border-t border-gray-100 pt-4","children":"The kids plan is designed for children aged 4–14. Nutritional requirements differ significantly between toddlers (1–3), school-age children (4–8), and adolescents (9–14). Select your child's age when setting up their profile and MealCoreAI will calibrate the portion sizes and nutrient targets accordingly."}]]}],["$","details","1",{"className":"border border-gray-200 rounded-2xl overflow-hidden group","children":[["$","summary",null,{"className":"px-5 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 flex items-center justify-between list-none","children":[["$","span",null,{"children":"Does the kids plan address fussy eating?"}],["$","span",null,{"className":"text-gray-400 group-open:rotate-180 transition-transform text-lg shrink-0 ml-3","children":"▾"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-700 text-sm leading-relaxed border-t border-gray-100 pt-4","children":"Yes — the kids plan prioritises foods that are nutritionally dense but accepted by most children, uses familiar formats, and suggests hidden-nutrition approaches (like spinach puree in paratha dough). It also provides alternative options within the same nutritional category for foods a child refuses."}]]}],["$","details","2",{"className":"border border-gray-200 rounded-2xl overflow-hidden group","children":[["$","summary",null,{"className":"px-5 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 flex items-center justify-between list-none","children":[["$","span",null,{"children":"What foods does MealCoreAI recommend for reducing LDL cholesterol?"}],["$","span",null,{"className":"text-gray-400 group-open:rotate-180 transition-transform text-lg shrink-0 ml-3","children":"▾"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-700 text-sm leading-relaxed border-t border-gray-100 pt-4","children":"The cholesterol plan centres around foods with the strongest clinical evidence: oats (beta-glucan), barley, flaxseeds, almonds, walnuts, garlic, legumes (rajma, chana), soybean, and plant sterols from whole grains. These foods can reduce LDL by 20–30% when eaten consistently."}]]}],["$","details","3",{"className":"border border-gray-200 rounded-2xl overflow-hidden group","children":[["$","summary",null,{"className":"px-5 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 flex items-center justify-between list-none","children":[["$","span",null,{"children":"Can I follow the cholesterol plan if I'm already on statins?"}],["$","span",null,{"className":"text-gray-400 group-open:rotate-180 transition-transform text-lg shrink-0 ml-3","children":"▾"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-700 text-sm leading-relaxed border-t border-gray-100 pt-4","children":"Yes — a heart-healthy diet complements statin therapy and may allow dose reduction over time. Specifically, a diet high in soluble fibre (from oats and legumes) has additive LDL-lowering effects beyond statins. Discuss any medication changes with your cardiologist."}]]}]]}]]}],["$","div","Pricing & Privacy",{"children":[["$","h2",null,{"className":"text-2xl font-bold text-gray-900 flex items-center gap-2 mb-6","children":[["$","span",null,{"children":"💳"}]," ","Pricing & Privacy"]}],["$","div",null,{"className":"space-y-3","children":[["$","details","0",{"className":"border border-gray-200 rounded-2xl overflow-hidden group","children":[["$","summary",null,{"className":"px-5 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 flex items-center justify-between list-none","children":[["$","span",null,{"children":"What does the free plan include?"}],["$","span",null,{"className":"text-gray-400 group-open:rotate-180 transition-transform text-lg shrink-0 ml-3","children":"▾"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-700 text-sm leading-relaxed border-t border-gray-100 pt-4","children":"The free plan includes 1 personalised meal plan per week, grocery list generation, 3 meal swaps per day, push notification reminders, and access to all 8 health condition tracks. No credit card required."}]]}],["$","details","1",{"className":"border border-gray-200 rounded-2xl overflow-hidden group","children":[["$","summary",null,{"className":"px-5 py-4 font-semibold text-gray-900 cursor-pointer hover:bg-gray-50 flex items-center justify-between list-none","children":[["$","span",null,{"children":"What does MealCoreAI Pro include?"}],["$","span",null,{"className":"text-gray-400 group-open:rotate-180 transition-transform text-lg shrink-0 ml-3","children":"▾"}]]}],["$","div",null,{"className":"px-5 pb-5 text-gray-700 text-sm leading-relaxed border-t border-gray-100 pt-4","children":"Pro (₹499/month or ₹2,999/year) includes unlimited meal plans, unlimited swaps, all 17 regional cui
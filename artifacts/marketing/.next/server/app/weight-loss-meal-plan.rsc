ildren":[["$","td",null,{"className":"px-5 py-4 font-bold text-gray-800 whitespace-nowrap","children":"Day 7"}],["$","td",null,{"className":"px-5 py-4 text-gray-700 leading-snug","children":"Ragi porridge with cinnamon + 5 almonds"}],["$","td",null,{"className":"px-5 py-4 text-gray-700 leading-snug","children":"Bajra roti (2) + soya chunk curry + salad"}],["$","td",null,{"className":"px-5 py-4 text-gray-700 leading-snug","children":"Green tea + handful of roasted pumpkin seeds"}],["$","td",null,{"className":"px-5 py-4 text-gray-700 leading-snug","children":"Moong dal soup + steamed vegetables + small curd bowl"}]]}]]}]]}]}],["$","p",null,{"className":"mt-5 text-sm text-gray-500 italic","children":"This is a sample plan. MealCoreAI generates a personalised version based on your region, preferences, and health goals."}],["$","div",null,{"className":"mt-6 p-6 bg-orange-50 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center gap-4","children":[["$","div",null,{"className":"flex-1","children":[["$","div",null,{"className":"font-bold text-gray-900 mb-1","children":["Get your personalised ","Weight Loss"," plan"]}],["$","div",null,{"className":"text-sm text-gray-500","children":"This sample plan is generic. MealCoreAI personalises every meal based on your region, cook time, allergies, and food preferences."}]]}],["$","a",null,{"href":"https://mealcoreai.com/app/sign-up","className":"shrink-0 inline-flex items-center gap-2 px-6 py-3 rounded-full text-white font-semibold text-sm shadow-lg transition-colors bg-emerald-600 hover:bg-emerald-700 shadow-emerald-200","children":["Get My Personalised ","Weight Loss"," Plan ",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}]}],["$","section",null,{"className":"py-16 bg-gray-50","children":["$","div",null,{"className":"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-black text-gray-900 mb-3","children":["Why Indian Food Is Ideal for ","Weight Loss"]}],["$","p",null,{"className":"text-gray-600 mb-10 max-w-2xl","children":["Your kitchen is already stocked with some of the most clinically researched ingredients for ","weight loss"," management. Here's what the science says about three of them."]}],["$","div",null,{"className":"space-y-10","children":[["$","div","Moong Dal",{"className":"max-w-3xl","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-900 mb-3","children":"Moong Dal"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-2","children":"Moong dal is one of the best weight-loss proteins in the Indian kitchen. It is low in calories (roughly 100 kcal per 100g cooked), high in protein (7g per 100g), and digests slowly enough to keep you full for 3-4 hours. Studies show that increasing dietary protein by 25-30% of total calories reduces overall food intake by approximately 400 calories per day without conscious restriction. For Indian weight loss, replacing one high-carb meal with a moong dal-based meal is the single easiest calorie reduction."}],["$","a",null,{"href":"https://pubmed.ncbi.nlm.nih.gov/16002798/","target":"_blank","rel":"noopener noreferrer","className":"text-sm text-gray-400 italic hover:text-orange-500 transition-colors","children":"Source: Weigle DS et al., American Journal of Clinical Nutrition, 2005."}]]}],["$","div","Jowar and Bajra Rotis",{"className":"max-w-3xl","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-900 mb-3","children":"Jowar and Bajra Rotis"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-2","children":"Jowar (sorghum) and bajra (pearl millet) rotis are 15-20% lower in calories than equivalent wheat rotis and contain significantly more fibre. A jowar roti provides roughly 60-65 kcal compared to 80-85 kcal for a standard wheat roti. More importantly, their higher fibre content slows gastric emptying — you feel full longer, eat less at the next meal, and reduce total daily calorie intake without tracking. Switching from wheat to millet rotis is the lowest-friction calorie reduction available in Indian cooking."}],["$","a",null,{"href":"https://www.nin.res.in","target":"_blank","rel":"noopener noreferrer","className":"text-sm text-gray-400 italic hover:text-orange-500 transition-colors","children":"Source: National Institute of Nutrition (NIN), ICMR, Nutritive Value of Indian Foods, 2017."}]]}],["$","div","Curd (Dahi)",{"className":"max-w-3xl","children":[["$","h3",null,{"className":"text-xl font-bold text-gray-900 mb-3","children":"Curd (Dahi)"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-2","children":"Curd is a near-perfect weight loss food for Indians. It is high in protein, low in calories, probiotic, and genuinely filling. Research shows that dietary calcium — abundant in curd — directly reduces fat cell synthesis and increases fat breakdown. A meta-analysis of dairy and weight loss found that high dairy consumption during calorie restriction led to 1.5x more fat loss than calorie restriction alone. Including 150-200g of curd with lunch and dinner satisfies dairy calcium needs while naturally reducing appetite."}],["$","a",null,{"href":"https://pubmed.ncbi.nlm.nih.gov/15090625/","target":"_blank","rel":"noopener noreferrer","className":"text-sm text-gray-400 italic hover:text-orange-500 transition-colors","children":"Source: Zemel MB et al., Obesity Research, 2004."}]]}]]}]]}]}],["$","section",null,{"className":"py-16 bg-white","children":["$","div",null,{"className":"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-black text-gray-900 mb-3","children":["Regional ","Weight Loss"," Meal Plan Variations"]}],["$","p",null,{"className":"text-gray-500 mb-10 max-w-2xl","children":["Managing ","weight loss"," through food looks different depending on where in India you cook. Here's how it adapts across three major food traditions."]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-3 gap-6","children":[["$","div",null,{"className":"bg-gray-50 border border-gray-200 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-gray-900 mb-3 text-lg","children":"🌴 South Indian"}],["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed mb-4","children":["South Indian cooking is built around rice, lentils, and fermented foods, all of which can be adapted for ","weight loss"," management. Swap white rice for ragi mudde or foxtail millet pongal, keep your sambar and rasam (they're excellent), and lean on pesarattu and dosas for high-protein breakfasts."]}],["$","a",null,{"href":"/meal-plans/weight-loss-weekly-meal-plan-south-indian","className":"text-orange-500 hover:text-orange-600 text-sm font-semibold inline-flex items-center gap-1","children":["See South Indian ","Weight Loss"," plan ",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-3 w-3","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","div",null,{"className":"bg-gray-50 border border-gray-200 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-gray-900 mb-3 text-lg","children":"🌾 North Indian"}],["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed mb-4","children":["The roti-dal-sabzi structure of North Indian cooking is one of the most naturally adaptable frameworks for ","weight loss",". Switch wheat atta to bajra or jowar flour, choose mustard oil or olive oil over vanaspati, and keep portions of dal generous. It's your best protein and fibre source."]}],["$","a",null,{"href":"/meal-plans/weight-loss-weekly-meal-plan-north-indian","className":"text-orange-500 hover:text-orange-600 text-sm font-semibold inline-flex items-center gap-1","children":["See North Indian ","Weight Loss"," plan ",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-3 w-3","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","div",null,{"className":"bg-gray-50 border border-gray-200 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-gray-900 mb-3 text-lg","children":"🎪 Gujarati"}],["$","p",null,{"className":"text-sm text-gray-600 leading-relaxed mb-4","children":["Gujarati food traditions (dhokla, khichdi, thepla, handvo) are naturally portion-controlled and often dal-forward. For ","weight loss",", the traditional Gujarati thali works well with small adjustments: less jaggery in sabzis, whole grain thepla instead of maida rotla, and moong dal khichdi as a staple dinner."]}],["$","a",null,{"href":"/meal-plans/weight-loss-weekly-meal-plan-gujarati","className":"text-orange-500 hover:text-orange-600 text-sm font-semibold inline-flex items-center gap-1","children":["See Gujarati ","Weight Loss"," plan ",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-3 w-3","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}]]}]}],["$","section",null,{"className":"py-10 bg-gray-50","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6","children":["$","div",null,{"className":"bg-blue-50 border border-blue-200 rounded-2xl p-6 flex gap-4","children":[["$","div",null,{"className":"text-2xl shrink-0","children":"⚕️"}],["$","div",null,{"children":[["$","h3",null,{"className":"font-bold text-gray-900 mb-2","children":"When to See a Doctor"}],["$","p",null,{"className":"text-sm text-gray-700 leading-relaxed","children":["Diet is one of the most powerful tools for managing ","weight loss",", but it works best alongside proper medical care. If you're newly diagnosed, experiencing severe symptoms, considering stopping medication, or your symptoms are worsening despite dietary changes, please consult your doctor or a specialist. MealCoreAI's meal plans are designed to complement medical treatment, not replace it. The nutrition guidance on this page is for educational purposes and does not constitute medical advice."]}]]}]]}]}]}],["$","section",null,{"className":"py-16 bg-white","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-black text-gray-900 mb-3","children":["Weight Loss"," Diet: Frequently Asked Questions"]}],["$","p",null,{"className":"text-gray-500 mb-10","children":["Evidence-based answers to the most common questions about ","Weight Loss"," nutrition."]}],["$","div",null,{"className":"space-y-3","children":[["$","details","Can I lose weight eating Indian food?",{"className":"border border-gray-200 rounded-2xl overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer hover:bg-gray-50 transition-colors list-none","children":[["$","span",null,{"className":"font-semibold text-gray-900 text-sm sm:text-base","children":"Can I lose weight eating Indian food?"}],["$","span",null,{"className":"text-gray-400 shrink-0 text-xl leading-none select-none","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-4","children":"Yes. Traditional Indian food — dal, sabzi, roti, curd — is naturally weight-loss-friendly when portions are managed correctly. The issue is not the cuisine but the quantity of grains, the timing of meals, and the addition of refined foods like maida and packaged snacks. A structured Indian weight loss meal plan maintains cultural food while creating a calorie deficit."}]]}],["$","details","How many rotis should I eat per day to lose weight?",{"className":"border border-gray-200 rounded-2xl overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer hover:bg-gray-50 transition-colors list-none","children":[["$","span",null,{"className":"font-semibold text-gray-900 text-sm sm:text-base","children":"How many rotis should I eat per day to lose weight?"}],["$","span",null,{"className":"text-gray-400 shrink-0 text-xl leading-none select-none","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-4","children":"For most Indian adults targeting weight loss, 2-3 small jowar or bajra rotis per meal is appropriate. The more important change is the ratio — make dal and sabzi the largest portion of your plate and reduce the grain portion. Eating dal and vegetables first before your roti naturally reduces how much grain you consume."}]]}],["$","details","Should I give up rice to lose weight?",{"className":"border border-gray-200 rounded-2xl overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer hover:bg-gray-50 transition-colors list-none","children":[["$","span",null,{"className":"font-semibold text-gray-900 text-sm sm:text-base","children":"Should I give up rice to lose weight?"}],["$","span",null,{"className":"text-gray-400 shrink-0 text-xl leading-none select-none","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-4","children":"Not necessarily. Rice can be included in an Indian weight loss plan if portion size is controlled and it is eaten with protein and fibre. Eating a small portion of rice after dal and sabzi — rather than rice as the main component — keeps blood sugar stable and total calorie intake lower. Brown rice or hand-pound rice provides more fibre."}]]}],["$","details","What is the best Indian breakfast for weight loss?",{"className":"border border-gray-200 rounded-2xl overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer hover:bg-gray-50 transition-colors list-none","children":[["$","span",null,{"className":"font-semibold text-gray-900 text-sm sm:text-base","children":"What is the best Indian breakfast for weight loss?"}],["$","span",null,{"className":"text-gray-400 shrink-0 text-xl leading-none select-none","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-4","children":"High-protein, low-GI breakfasts work best for Indian weight loss. Besan cheela with mint chutney, moong dal chilla with curd, ragi dosa with sambar, or two boiled eggs with one jowar roti are all effective options. Eating breakfast within 30-45 minutes of waking prevents cortisol spikes that drive fat storage."}]]}],["$","details","How long does it take to lose weight on an Indian diet?",{"className":"border border-gray-200 rounded-2xl overflow-hidden","children":[["$","summary",null,{"className":"flex items-center justify-between gap-4 px-6 py-5 cursor-pointer hover:bg-gray-50 transition-colors list-none","children":[["$","span",null,{"className":"font-semibold text-gray-900 text-sm sm:text-base","children":"How long does it take to lose weight on an Indian diet?"}],["$","span",null,{"className":"text-gray-400 shrink-0 text-xl leading-none select-none","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"px-6 pb-6 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-4","children":"With a consistent Indian weight loss meal plan — calorie deficit of 300-500 calories per day — most people lose 0.5-1 kg per week. Results are visible in 3-4 weeks. The advantage of using Indian food is sustainability — you are eating food you already know and enjoy, which makes long-term consistency far more achievable than Western diet plans."}]]}]]}]]}]}],null,["$","section",null,{"className":"py-16 bg-gray-50","children":["$","div",null,{"className":"max-w-5xl mx-auto px-4","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-black text-gray-900 mb-3","children":"Weight Loss Meal Plans by Region"}],["$","p",null,{"className":"text-gray-500 mb-8","children":"AI-personalised meal plans for your region, built on traditional Indian recipes."}],["$","div",null,{"className":"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3","children":[["$","$L3","/meal-plans/weight-loss-meal-plan-south-indian",{"href":"/meal-plans/weight-loss-meal-plan-south-indian","className":"flex items-center gap-2 px-4 py-3 rounded-xl bg-white border border-gray-200 hover:border-orange-300 hover:shadow-sm text-sm font-medium text-gray-700 hover:text-orange-600 transition-all","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4 shrink-0 text-orange-400","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}],"South Indian Weight Loss Meal Plan"]}],["$","$L3","/meal-plans/weight-loss-meal-plan-north-indian",{"href":"/meal-plans/weight-loss-meal-plan-north-indian","className":"flex items-center gap-2 px
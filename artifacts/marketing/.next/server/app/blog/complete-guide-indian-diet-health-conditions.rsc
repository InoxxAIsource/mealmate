",{"children":["$","$L8",null,{"href":"/pricing","className":"text-sm hover:text-orange-400 transition-colors","children":"Pricing"}]}]]}]]}],["$","div","Condition Plans",{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-gray-500 mb-4","children":"Condition Plans"}],["$","ul",null,{"className":"space-y-2.5","children":[["$","li","PCOS Meal Plan",{"children":["$","$L8",null,{"href":"/pcos-meal-plan","className":"text-sm hover:text-orange-400 transition-colors","children":"PCOS Meal Plan"}]}],["$","li","Diabetes Meal Plan",{"children":["$","$L8",null,{"href":"/diabetes-meal-plan","className":"text-sm hover:text-orange-400 transition-colors","children":"Diabetes Meal Plan"}]}],["$","li","Thyroid Diet Plan",{"children":["$","$L8",null,{"href":"/thyroid-diet-plan","className":"text-sm hover:text-orange-400 transition-colors","children":"Thyroid Diet Plan"}]}],["$","li","Pregnancy Meal Plan",{"children":["$","$L8",null,{"href":"/pregnancy-meal-plan","className":"text-sm hover:text-orange-400 transition-colors","children":"Pregnancy Meal Plan"}]}],["$","li","Kids Meal Plan",{"children":["$","$L8",null,{"href":"/kids-meal-plan","className":"text-sm hover:text-orange-400 transition-colors","children":"Kids Meal Plan"}]}],["$","li","Cholesterol Diet Plan",{"children":["$","$L8",null,{"href":"/cholesterol-diet-plan","className":"text-sm hover:text-orange-400 transition-colors","children":"Cholesterol Diet Plan"}]}]]}]]}],["$","div","Company",{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-gray-500 mb-4","children":"Company"}],["$","ul",null,{"className":"space-y-2.5","children":[["$","li","About",{"children":["$","$L8",null,{"href":"/about","className":"text-sm hover:text-orange-400 transition-colors","children":"About"}]}],["$","li","Blog",{"children":["$","$L8",null,{"href":"/blog","className":"text-sm hover:text-orange-400 transition-colors","children":"Blog"}]}],["$","li","Privacy Polic